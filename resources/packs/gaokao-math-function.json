    { "id": "root", "name": "函数", "parentId": null, "kind": "root", "examWeight": 1.0, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "高中数学的主干板块，一切后续内容（导数、数列、不等式）都建立在这里。" },

    { "id": "A", "name": "函数概念", "parentId": "root", "kind": "concept", "examWeight": 0.9, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "定义、定义域、值域、对应关系，以及分段函数。" },
    { "id": "A1", "name": "定义", "parentId": "A", "kind": "concept", "examWeight": 0.7, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "非空数集到非空数集的对应；判断两个函数是否相同只看定义域和对应关系。" },
    { "id": "A2", "name": "定义域", "parentId": "A", "kind": "concept", "examWeight": 0.85, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "先看定义域再谈性质，这是函数题的第一道门。" },
    { "id": "A3", "name": "值域", "parentId": "A", "kind": "concept", "examWeight": 0.6, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "所有函数值构成的集合；求值域常用配方法、换元法、单调性法。" },
    { "id": "A5", "name": "分段函数", "parentId": "A", "kind": "concept", "examWeight": 0.45, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "不同区间用不同式子；代入时先判断自变量落在哪一段。" },
    { "id": "A2a", "name": "分式", "parentId": "A2", "kind": "concept", "examWeight": 0.6, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "分母不为零，是定义域里最常被漏掉的一条。" },
    { "id": "A2b", "name": "根式", "parentId": "A2", "kind": "concept", "examWeight": 0.6, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "偶次根号内 ≥0；奇次根号无限制。" },
    { "id": "A2c", "name": "对数真数", "parentId": "A2", "kind": "concept", "examWeight": 0.7, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "真数 >0 且底数 >0 且 ≠1，两条同时成立。" },
    { "id": "A2d", "name": "实际约束", "parentId": "A2", "kind": "concept", "examWeight": 0.3, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "应用题里长度、人数、时间要符合实际意义，别只解出数学解。" },

    { "id": "B", "name": "函数性质", "parentId": "root", "kind": "concept", "examWeight": 0.95, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "单调性、奇偶性、周期性、对称性、最值、零点，是解题的工具箱。" },
    { "id": "B1", "name": "单调性", "parentId": "B", "kind": "concept", "examWeight": 0.9, "weightSource": "manual", "prereq": ["A1"], "confusable": [], "brief": "图象上升还是下降；判断单调区间必须写在定义域内。" },
    { "id": "B2", "name": "奇偶性", "parentId": "B", "kind": "concept", "examWeight": 0.7, "weightSource": "manual", "prereq": [], "confusable": ["B4"], "brief": "先看定义域是否关于原点对称，再看 f(-x) 与 f(x) 的关系。" },
    { "id": "B3", "name": "周期性", "parentId": "B", "kind": "concept", "examWeight": 0.5, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "f(x+T)=f(x)，最小正周期是使等式成立的最小正数。" },
    { "id": "B4", "name": "对称性", "parentId": "B", "kind": "concept", "examWeight": 0.45, "weightSource": "manual", "prereq": [], "confusable": ["B2"], "brief": "轴对称与中心对称；奇偶性其实是关于原点和 y 轴的特殊对称。" },
    { "id": "B5", "name": "最值", "parentId": "B", "kind": "concept", "examWeight": 0.8, "weightSource": "manual", "prereq": ["A3"], "confusable": [], "brief": "区间端点与极值点比较；二次函数看对称轴落不落在区间内。" },
    { "id": "B6", "name": "零点存在", "parentId": "B", "kind": "concept", "examWeight": 0.75, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "连续函数在两端异号则区间内必有零点；只能判定存在，不能定位个数。" },
    { "id": "B1a", "name": "定义法证明", "parentId": "B1", "kind": "skill", "examWeight": 0.5, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "设 x1<x2、作差、变形、定号、下结论，五步走。" },
    { "id": "B1b", "name": "复合单调", "parentId": "B1", "kind": "skill", "examWeight": 0.7, "weightSource": "manual", "prereq": ["B1a"], "confusable": [], "brief": "同增异减：内外层单调性相同则复合递增，相反则递减。" },

    { "id": "C", "name": "基本初等函数", "parentId": "root", "kind": "concept", "examWeight": 0.95, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "指数、对数、幂函数三大件，加上图象变换和反函数。" },
    { "id": "C1", "name": "指数函数", "parentId": "C", "kind": "concept", "examWeight": 0.95, "weightSource": "manual", "prereq": ["B1"], "confusable": ["C2", "C3"], "brief": "y=a^x（a>0 且 a≠1），过 (0,1)，恒正。" },
    { "id": "C2", "name": "对数函数", "parentId": "C", "kind": "concept", "examWeight": 0.95, "weightSource": "manual", "prereq": ["A2", "B1"], "confusable": ["C1"], "brief": "y=log_a x，过 (1,0)，定义域 (0,+∞)。" },
    { "id": "C3", "name": "幂函数", "parentId": "C", "kind": "concept", "examWeight": 0.6, "weightSource": "manual", "prereq": [], "confusable": ["C1"], "brief": "y=x^α，α 决定定义域、奇偶与单调，最容易和指数函数搞混。" },
    { "id": "C4", "name": "图像变换", "parentId": "C", "kind": "concept", "examWeight": 0.65, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "平移、伸缩、翻折三件事，口诀：左加右减、上加下减。" },
    { "id": "C5", "name": "反函数", "parentId": "C", "kind": "concept", "examWeight": 0.35, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "指数与对数互为反函数，图象关于 y=x 对称。" },
    { "id": "C1a", "name": "底数分类", "parentId": "C1", "kind": "concept", "examWeight": 0.7, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "a>1 递增、0<a<1 递减；比较大小前先看底数范围和 0/1 分界。" },
    { "id": "C1b", "name": "单调性判断", "parentId": "C1", "kind": "skill", "examWeight": 0.75, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "底数与 1 比较即可；含参时必须分 a>1 与 0<a<1 两种讨论。" },
    { "id": "C1c", "name": "比较大小", "parentId": "C1", "kind": "skill", "examWeight": 0.8, "weightSource": "manual", "prereq": ["C2"], "confusable": ["C2d"], "brief": "同底看单调性，同指数看底数，都不同就插入中间量（通常是 1）。" },
    { "id": "C1d", "name": "过定点", "parentId": "C1", "kind": "concept", "examWeight": 0.5, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "含参数的指数函数必过某个定点，令指数为 0 即可求出。" },
    { "id": "C1e", "name": "指数方程", "parentId": "C1", "kind": "skill", "examWeight": 0.55, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "化为同底，或换元成二次方程再回代。" },
    { "id": "C2a", "name": "对数运算", "parentId": "C2", "kind": "concept", "examWeight": 0.75, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "积变和、商变差、幂提前，是最常考的基本功。" },
    { "id": "C2b", "name": "换底公式", "parentId": "C2", "kind": "skill", "examWeight": 0.6, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "log_a b = ln b / ln a，用来统一底数再运算。" },
    { "id": "C2c", "name": "定义域", "parentId": "C2", "kind": "concept", "examWeight": 0.7, "weightSource": "manual", "prereq": ["A2c"], "confusable": [], "brief": "真数大于零、底数大于零且不等于 1，二者缺一不可。" },
    { "id": "C2d", "name": "比较大小", "parentId": "C2", "kind": "skill", "examWeight": 0.8, "weightSource": "manual", "prereq": ["C2a"], "confusable": ["C1c"], "brief": "同底看单调性，不同底可用换底或插入 0、1 作中间量。" },
    { "id": "C2e", "name": "对数方程", "parentId": "C2", "kind": "skill", "examWeight": 0.55, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "化为同底后脱去对数，最后一定要检验真数为正。" },
    { "id": "C3a", "name": "五个幂函数", "parentId": "C3", "kind": "concept", "examWeight": 0.45, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "x、x²、x³、x^½、x⁻¹ 的图象与定义域要能默画。" },
    { "id": "C3b", "name": "幂函数性质", "parentId": "C3", "kind": "concept", "examWeight": 0.5, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "α>0 在 (0,+∞) 递增；α<0 递减；过 (1,1) 恒成立。" },
    { "id": "C4a", "name": "平移", "parentId": "C4", "kind": "concept", "examWeight": 0.6, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "左加右减（作用于 x）、上加下减（作用于整体）。" },
    { "id": "C4b", "name": "伸缩", "parentId": "C4", "kind": "concept", "examWeight": 0.55, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "横向伸缩看 x 的系数倒数，纵向伸缩直接乘。" },

    { "id": "D", "name": "函数应用", "parentId": "root", "kind": "concept", "examWeight": 0.5, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "建模与零点，把函数用回实际问题。" },
    { "id": "D1", "name": "函数建模", "parentId": "D", "kind": "concept", "examWeight": 0.35, "weightSource": "manual", "prereq": [], "confusable": [], "brief": "读题找自变量与因变量，写出关系式并标明定义域。" },
    { "id": "D2", "name": "零点与方程", "parentId": "D", "kind": "concept", "examWeight": 0.7, "weightSource": "manual", "prereq": ["B6"], "confusable": [], "brief": "方程 f(x)=0 的解就是 f 的零点，就是图象与 x 轴交点的横坐标。" }
  ],
